# ==========================================================================
# Aurora Prisma NetTools — variáveis de ambiente
# Copie para `.env` e ajuste. Segredos: gere valores fortes, ex.:
#   openssl rand -hex 32
# ==========================================================================

# --- Segredos (OBRIGATÓRIO trocar) ---------------------------------------
# Chave Fernet usada para cifrar segredos no banco (credenciais, api-keys,
# senhas SMTP/S3/LLM). Se mudar depois, os segredos já cifrados ficam ilegíveis.
APP_SECRET_KEY=troque-esta-chave-fernet
# Assina os tokens JWT (login, reset de senha).
JWT_SECRET=troque-este-jwt-secret
# Access token curto (minutos). Sessão longa via refresh_token (Redis).
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
# Cookies HttpOnly (AUTH-003). COOKIE_SECURE=true com HTTPS no browser.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/
# Dev Vite cross-origin (opcional): CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# --- Admin inicial (semeado no 1º boot) ----------------------------------
# Usuário Master do sistema. Defina uma senha forte antes do primeiro start.
# O login é por E-MAIL + senha; informe ADMIN_EMAIL para o Master já entrar por e-mail
# (o username continua funcionando como fallback para contas sem e-mail).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=troque-esta-senha

# --- Postgres ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aurora
POSTGRES_USER=aurora
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Backend / MCP -------------------------------------------------------
HOST=0.0.0.0
PORT=8000
MCP_TRANSPORT=streamable-http
MCP_PATH=/mcp

# --- SNMP ----------------------------------------------------------------
# MIBs embutidas na imagem do backend.
MIBS_PATH=/app/mibs

# --- Poller de status/métricas RouterOS (background) ---------------------
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=60
POLL_CONCURRENCY=4
SAMPLE_RETENTION_DAYS=30

# --- Observabilidade (aba /logs → Observabilidade, só Admin Master) ------
# Pasta dos logs brutos JSONL dentro do container (montada de ./log no compose).
LOG_DIR=/app/log
# Nível mínimo gravado em arquivo (o stdout continua INFO).
# WARNING é o recomendado; INFO deixa o arquivo grande rápido.
LOG_FILE_LEVEL=WARNING
# Rotação: 10MB por arquivo, 5 backups (~60MB no total).
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Prometheus /metrics (RED + gauges Postgres/Redis). true = ligado.
METRICS_ENABLED=true

# --- Seed do controller Fiberhome (UNM2000), opcional --------------------
# Se preenchido, cria a controladora + credencial cifrada no 1º boot.
TL1_HOST=
TL1_PORT=3337
TL1_USERNAME=
TL1_PASSWORD=

# ==========================================================================
# Deploy / Docker Compose
# ==========================================================================
# Porta pública do proxy (Caddy) — ponto de entrada único da aplicação.
PROXY_PORT=8090
# Porta do host mapeada para o backend (só no docker-compose.yml de dev;
# no deploy via docker-compose.harbor.yml o backend fica interno).
BACKEND_PORT=8000

# --- Registry Harbor (build/push/pull das imagens) -----------------------
REGISTRY=registry.aurora.app.br/aurora-nettools
IMAGE_TAG=latest

# === Backup dedicado (serviço 'backup': pg_dump -> S3 próprio) ===
# Credenciais S3 PRÓPRIAS do backup (separadas das do app, de propósito).
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_ENDPOINT=            # vazio = AWS S3; ex.: https://minio.exemplo.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=backups/
BACKUP_S3_USE_SSL=true
# Agenda: horário fixo diário de madrugada (HH:MM no fuso BACKUP_TZ).
BACKUP_TZ=America/Sao_Paulo
BACKUP_AT=03:00
BACKUP_RETENTION_DAYS=14
BACKUP_RUN_ON_START=true
# Alerta por e-mail em QUALQUER falha do backup (SMTP próprio do backup).
# Deixe BACKUP_ALERT_EMAIL/BACKUP_SMTP_HOST vazios para desligar o alerta.
BACKUP_ALERT_EMAIL=            # e-mail do admin geral que recebe os alertas
BACKUP_SMTP_HOST=             # ex.: smtp.gmail.com
BACKUP_SMTP_PORT=587          # 465 = SSL; 587 = STARTTLS
BACKUP_SMTP_USERNAME=
BACKUP_SMTP_PASSWORD=
BACKUP_SMTP_FROM=             # remetente; vazio = usa o USERNAME
BACKUP_SMTP_USE_TLS=true
HUB_AURORA_TOKEN=
HUB_AURORA_URL=https://hub.admin.aurora.api.br/

# Link de suporte no app — botão "Falar com o suporte" (WhatsApp) na tela de
# plano vencido. Vazio = botão oculto. Ex.: https://wa.me/5511999999999
SUPPORT_WHATSAPP_URL=